import importlib.util
import pathlib
import sys

import pytest

EXTENSION_DIR = pathlib.Path(__file__).resolve().parent.parent / "extension"
PACKAGE = "extension_under_test"


@pytest.fixture
def extension():
    """The extension loaded from its source folder and registered."""
    spec = importlib.util.spec_from_file_location(
        PACKAGE,
        EXTENSION_DIR / "__init__.py",
        submodule_search_locations=[str(EXTENSION_DIR)],
    )
    module = importlib.util.module_from_spec(spec)
    sys.modules[PACKAGE] = module
    spec.loader.exec_module(module)
    module.register()
    yield module
    module.unregister()
    for name in [name for name in sys.modules if name.startswith(PACKAGE)]:
        del sys.modules[name]


def test_register_adds_the_operator_and_the_panel(extension):
    import bpy

    assert hasattr(bpy.types, "{{ package_slug|upper }}_OT_hello")
    assert hasattr(bpy.types, "{{ package_slug|upper }}_PT_main")


def test_the_operator_runs(extension):
    import bpy

    assert bpy.ops.{{ package_slug }}.hello() == {"FINISHED"}


def test_unregister_removes_what_register_added():
    import bpy

    spec = importlib.util.spec_from_file_location(
        PACKAGE,
        EXTENSION_DIR / "__init__.py",
        submodule_search_locations=[str(EXTENSION_DIR)],
    )
    module = importlib.util.module_from_spec(spec)
    sys.modules[PACKAGE] = module
    spec.loader.exec_module(module)
    module.register()

    module.unregister()

    assert not hasattr(bpy.types, "{{ package_slug|upper }}_OT_hello")
    assert not hasattr(bpy.types, "{{ package_slug|upper }}_PT_main")
    for name in [name for name in sys.modules if name.startswith(PACKAGE)]:
        del sys.modules[name]
