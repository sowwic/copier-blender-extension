version: 2
updates:
  - package-ecosystem: "uv"
    directory: "/"
    target-branch: "{{ develop_branch }}"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    groups:
      minor-and-patch:
        update-types: ["minor", "patch"]
    labels: ["dependencies"]

  - package-ecosystem: "github-actions"
    directory: "/"
    target-branch: "{{ develop_branch }}"
    schedule:
      interval: "weekly"
    groups:
      actions:
        patterns: ["*"]
